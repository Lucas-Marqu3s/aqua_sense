<Layouts.app flash={@flash} variant={:bare}>
  <div class="flex min-h-screen bg-canvas text-ink">
    <%!-- Painel de apresentação: só a partir de lg. No celular a tela é o formulário. --%>
    <aside class="hidden w-[760px] shrink-0 flex-col justify-between border-r border-hairline bg-surface p-12 lg:flex">
      <div class="flex items-center gap-2.5">
        <span class="flex size-9 shrink-0 items-center justify-center rounded-lg bg-level text-white">
          <.icon name="hero-beaker" class="size-5" />
        </span>
        <span class="text-[19px] font-bold tracking-tight">AquaSense</span>
      </div>

      <div class="flex flex-col gap-11">
        <div class="flex max-w-[560px] flex-col gap-4">
          <span class="as-eyebrow">Reservatório subterrâneo · Poço PT-01</span>
          <h2 class="text-[42px] leading-[1.12] font-bold tracking-tight">
            Qualidade da água,<br />medida na fonte.
          </h2>
          <p class="max-w-[460px] text-[15px] leading-relaxed text-ink-2">
            Uma leitura a cada 30 minutos, comparada com os limites da Portaria GM/MS nº 888/2021.
          </p>
        </div>

        <div class="max-w-[560px]">
          <.well_figure />
          <p class="as-num mt-3.5 text-xs text-ink-3">sonda a 12 m · leitura a cada 30 min</p>
        </div>
      </div>

      <p class="text-xs text-ink-3">TCC · Engenharia de Computação · FACENS</p>
    </aside>

    <div class="flex grow items-center justify-center p-8">
      <div class="flex w-full max-w-[392px] flex-col gap-6">
        <div class="flex items-center gap-2.5 lg:hidden">
          <span class="flex size-8 shrink-0 items-center justify-center rounded-lg bg-level text-white">
            <.icon name="hero-beaker" class="size-4.5" />
          </span>
          <span class="text-[17px] font-bold tracking-tight">AquaSense</span>
        </div>

        <%= if @live_action == :register do %>
          <div class="flex flex-col gap-1.5">
            <.link navigate="/sign-in" class="text-[13px] font-medium text-ink-2 hover:text-ink">
              ← Voltar para o login
            </.link>
            <h1 class="text-[27px] font-bold tracking-tight">Solicitar cadastro</h1>
            <p class="text-sm text-ink-2">
              Seu acesso é liberado por um administrador após a conferência dos dados.
            </p>
          </div>

          <form
            id="register-form"
            method="post"
            action="/auth/user/password/register"
            class="flex flex-col gap-1"
          >
            <input type="hidden" name="_csrf_token" value={Plug.CSRFProtection.get_csrf_token()} />

            <.input
              id="register-name"
              name="user[name]"
              value=""
              type="text"
              label="Nome completo"
              placeholder="Maria Oliveira"
              autocomplete="name"
              required
            />
            <.input
              id="register-email"
              name="user[email]"
              value=""
              type="email"
              label="E-mail institucional"
              placeholder="voce@facens.br"
              autocomplete="email"
              required
            />
            <.input
              id="register-password"
              name="user[password]"
              value=""
              type="password"
              label="Senha"
              placeholder="mínimo 8 caracteres"
              autocomplete="new-password"
              minlength="8"
              required
            />
            <.input
              id="register-password-confirmation"
              name="user[password_confirmation]"
              value=""
              type="password"
              label="Confirmar senha"
              placeholder="Repita a senha"
              autocomplete="new-password"
              required
            />

            <button id="register-submit" type="submit" class="as-btn as-btn-primary mt-2 w-full">
              Enviar solicitação
            </button>
          </form>

          <p class="text-center text-xs leading-relaxed text-ink-3">
            Ao enviar, você concorda que seus dados sejam usados apenas para controle de acesso ao
            painel.
          </p>
        <% else %>
          <div class="flex flex-col gap-1.5">
            <h1 class="text-[27px] font-bold tracking-tight">Entrar</h1>
            <p class="text-sm text-ink-2">Use o e-mail cadastrado pela coordenação.</p>
          </div>

          <form
            id="sign-in-form"
            method="post"
            action="/auth/user/password/sign_in"
            class="flex flex-col gap-1"
          >
            <input type="hidden" name="_csrf_token" value={Plug.CSRFProtection.get_csrf_token()} />

            <.input
              id="sign-in-email"
              name="user[email]"
              value=""
              type="email"
              label="E-mail"
              placeholder="voce@facens.br"
              autocomplete="email"
              required
            />
            <.input
              id="sign-in-password"
              name="user[password]"
              value=""
              type="password"
              label="Senha"
              placeholder="••••••••"
              autocomplete="current-password"
              required
            />

            <div class="mb-4 flex justify-end">
              <.link href="/reset" class="text-[12.5px] font-medium text-level hover:underline">
                Esqueci minha senha
              </.link>
            </div>

            <button id="sign-in-submit" type="submit" class="as-btn as-btn-primary w-full">
              Entrar
            </button>
          </form>

          <p class="text-center text-[13.5px] text-ink-2">
            Não tem acesso?
            <.link navigate="/register" class="font-semibold text-level hover:underline">
              Solicitar cadastro
            </.link>
          </p>

          <p class="text-center text-[12.5px] leading-relaxed text-ink-3">
            Novas contas passam por aprovação de um administrador antes do primeiro acesso.
          </p>
        <% end %>
      </div>
    </div>
  </div>
</Layouts.app>
