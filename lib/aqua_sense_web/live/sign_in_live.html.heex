<Layouts.app flash={@flash} variant={:bare}>
  <div class="flex min-h-screen overflow-x-hidden bg-canvas text-ink">
    <aside class="relative hidden h-screen max-w-[70%] shrink-0 overflow-hidden border-r border-hairline bg-slate-950 lg:block lg:aspect-[1115/941]">
      <img
        src={~p"/images/login-hero.png"}
        alt=""
        aria-hidden="true"
        class="size-full object-cover"
      />

      <div class="absolute inset-0 flex flex-col justify-between pt-4">
        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/25 to-black/10">
        </div>

        <img
          src={~p"/images/logo_aquasense.png"}
          alt="AquaSense"
          class="relative h-32 w-auto self-start drop-shadow-md"
        />
      </div>
    </aside>

    <div class="flex w-full min-w-0 grow items-center justify-center p-8">
      <div class="flex w-full max-w-[360px] flex-col gap-6">
        <div class="flex items-center lg:hidden">
          <img
            src={~p"/images/logo_aquasense.png"}
            alt="AquaSense"
            class="size-full h-32 object-contain"
          />
        </div>

        <%= if @live_action == :register do %>
          <div class="flex flex-col gap-1.5">
            <.link navigate="/sign-in" class="text-[13px] font-medium text-ink-2 hover:text-ink">
              ← Voltar para o login
            </.link>
            <h1 class="text-[27px] font-bold tracking-tight">Solicitar cadastro</h1>
            <p class="text-sm text-ink-2">
              Seu acesso é liberado por um administrador após a conferência dos dados.
            </p>
          </div>

          <form
            id="register-form"
            method="post"
            action="/auth/user/password/register"
            phx-hook=".CheckPasswordMatch"
            class="flex flex-col gap-1"
          >
            <input type="hidden" name="_csrf_token" value={Plug.CSRFProtection.get_csrf_token()} />

            <.input
              id="register-name"
              name="user[name]"
              value=""
              type="text"
              label="Nome completo"
              placeholder="Nome completo"
              autocomplete="name"
              required
            />
            <.input
              id="register-email"
              name="user[email]"
              value=""
              type="email"
              label="E-mail institucional"
              placeholder="Digite seu e-mail"
              autocomplete="email"
              required
            />
            <.input
              id="register-password"
              name="user[password]"
              value=""
              type="password"
              label="Senha"
              placeholder="mínimo 8 caracteres"
              autocomplete="new-password"
              minlength="8"
              required
            />
            <.input
              id="register-password-confirmation"
              name="user[password_confirmation]"
              value=""
              type="password"
              label="Confirmar senha"
              placeholder="Repita a senha"
              autocomplete="new-password"
              required
            />
            <p
              id="register-password-mismatch"
              class="mt-1.5 mb-3 hidden items-center gap-2 text-[12.5px] text-crit"
            >
              <.icon name="hero-exclamation-circle" class="size-5 shrink-0" />
              As senhas não coincidem. Digite novamente.
            </p>

            <button id="register-submit" type="submit" class="as-btn as-btn-primary mt-2 w-full">
              Enviar solicitação
            </button>
          </form>
          <script :type={Phoenix.LiveView.ColocatedHook} name=".CheckPasswordMatch">
            export default {
              mounted() {
                const password = this.el.querySelector("#register-password")
                const confirmation = this.el.querySelector("#register-password-confirmation")
                const message = this.el.querySelector("#register-password-mismatch")

                this.el.addEventListener("submit", (e) => {
                  if (password.value === confirmation.value) {
                    return
                  }

                  e.preventDefault()
                  password.classList.add("as-field-error")
                  confirmation.classList.add("as-field-error")
                  message.classList.remove("hidden")
                  message.classList.add("flex")
                  password.focus()
                })

                for (const field of [password, confirmation]) {
                  field.addEventListener("input", () => {
                    field.classList.remove("as-field-error")
                    message.classList.add("hidden")
                    message.classList.remove("flex")
                  })
                }
              }
            }
          </script>

          <p class="text-center text-xs leading-relaxed text-ink-3">
            Ao enviar, você concorda que seus dados sejam usados apenas para controle de acesso ao
            painel.
          </p>
        <% else %>
          <div class="flex flex-col gap-1.5">
            <h1 class="text-[27px] font-bold tracking-tight">Entrar</h1>
            <p class="text-sm text-ink-2">Use o e-mail cadastrado pela coordenação.</p>
          </div>

          <form
            id="sign-in-form"
            method="post"
            action="/auth/user/password/sign_in"
            class="flex flex-col gap-1"
          >
            <input type="hidden" name="_csrf_token" value={Plug.CSRFProtection.get_csrf_token()} />

            <.input
              id="sign-in-email"
              name="user[email]"
              value=""
              type="email"
              label="E-mail"
              placeholder="Digite seu e-mail"
              autocomplete="email"
              required
            />
            <.input
              id="sign-in-password"
              name="user[password]"
              value=""
              type="password"
              label="Senha"
              placeholder="Digite sua senha"
              autocomplete="current-password"
              required
            />

            <div class="mb-4 flex justify-end">
              <.link href="/reset" class="text-[12.5px] font-medium text-level hover:underline">
                Esqueci minha senha
              </.link>
            </div>

            <button id="sign-in-submit" type="submit" class="as-btn as-btn-primary w-full">
              Entrar
            </button>
          </form>

          <p class="text-center text-[13.5px] text-ink-2">
            Não tem acesso?
            <.link navigate="/register" class="font-semibold text-level hover:underline">
              Solicitar cadastro
            </.link>
          </p>
        <% end %>
      </div>
    </div>
  </div>
</Layouts.app>
