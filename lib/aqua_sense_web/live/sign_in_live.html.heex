<div class="min-h-screen flex" style="background:#030712;" data-theme="dark">

  <%!-- ═══ LEFT — Branding ═══ --%>
  <div class="hidden lg:flex w-1/2 flex-col justify-between p-12 relative overflow-hidden"
       style="background:linear-gradient(135deg,#0c1a2e 0%,#0e4f6e 60%,#0891b2 100%);">

    <%!-- Background circles --%>
    <div class="absolute inset-0 pointer-events-none">
      <div class="absolute rounded-full opacity-10" style="width:400px;height:400px;background:#22d3ee;top:-100px;right:-100px;"></div>
      <div class="absolute rounded-full opacity-5" style="width:300px;height:300px;background:#22d3ee;bottom:50px;left:-80px;"></div>
    </div>

    <%!-- Logo --%>
    <div class="relative flex items-center gap-3">
      <div class="w-10 h-10 rounded-xl flex items-center justify-center" style="background:#22d3ee22;border:1px solid #22d3ee44;">
        <.icon name="hero-beaker" class="w-6 h-6 text-cyan-400" />
      </div>
      <span class="text-xl font-bold text-white">AquaMonitor</span>
    </div>

    <%!-- Center content --%>
    <div class="relative space-y-6">
      <%!-- Animated tank illustration --%>
      <div class="flex justify-center mb-8">
        <div class="relative rounded-2xl border-2 overflow-hidden" style="width:80px;height:160px;background:#020617;border-color:#22d3ee44;">
          <div class="absolute bottom-0 left-0 right-0" style="height:72%;background:linear-gradient(to top,#0e4f6e,#0891b2aa);">
            <div class="absolute inset-x-0 overflow-hidden" style="top:-6px;height:12px;">
              <div class="aqua-wave-anim flex" style="width:200%;">
                <svg viewBox="0 0 80 10" style="width:50%;" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
                  <path d="M0,5 C10,1 20,9 30,5 C40,1 50,9 60,5 C70,1 80,9 80,5 L80,10 L0,10 Z" fill="#22d3ee" opacity="0.6"/>
                </svg>
                <svg viewBox="0 0 80 10" style="width:50%;" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
                  <path d="M0,5 C10,1 20,9 30,5 C40,1 50,9 60,5 C70,1 80,9 80,5 L80,10 L0,10 Z" fill="#22d3ee" opacity="0.6"/>
                </svg>
              </div>
            </div>
          </div>
        </div>
      </div>

      <h1 class="text-4xl font-bold text-white leading-tight">
        Monitoramento<br/>
        <span style="color:#22d3ee;">Inteligente</span><br/>
        de Reservatórios
      </h1>
      <p class="text-lg" style="color:#93c5fd;">
        Acompanhe nível, temperatura, turbidez e condutividade
        em tempo real, com alertas automáticos e histórico completo.
      </p>

      <%!-- Feature list --%>
      <ul class="space-y-3">
        <%= for item <- ["Dados em tempo real via ESP32 + MQTT", "Alertas conforme Portaria GM/MS nº 888/2021", "Histórico e exportação de medições"] do %>
          <li class="flex items-center gap-3 text-sm" style="color:#bfdbfe;">
            <div class="w-5 h-5 rounded-full flex-none flex items-center justify-center" style="background:#22d3ee22;">
              <.icon name="hero-check" class="w-3 h-3 text-cyan-400" />
            </div>
            {item}
          </li>
        <% end %>
      </ul>
    </div>

    <%!-- Footer --%>
    <div class="relative text-xs" style="color:#64748b;">
      TCC — FACENS · Engenharia de Computação
    </div>
  </div>

  <%!-- ═══ RIGHT — Login Form ═══ --%>
  <div class="flex-1 flex items-center justify-center p-8">
    <div class="w-full max-w-sm space-y-8">

      <%!-- Mobile logo --%>
      <div class="flex lg:hidden items-center gap-2 justify-center">
        <div class="w-8 h-8 rounded-lg flex items-center justify-center" style="background:#164e63;">
          <.icon name="hero-beaker" class="w-4 h-4 text-cyan-400" />
        </div>
        <span class="font-bold" style="color:#f8fafc;">AquaMonitor</span>
      </div>

      <%!-- Title --%>
      <div>
        <h2 class="text-2xl font-bold" style="color:#f8fafc;">Bem-vindo de volta</h2>
        <p class="text-sm mt-1" style="color:#64748b;">Faça login para acessar o dashboard</p>
      </div>

      <%!-- Error alert --%>
      <%= if @error do %>
        <div class="flex items-center gap-3 px-4 py-3 rounded-lg text-sm" style="background:#450a0a88;border:1px solid #f8717144;color:#fca5a5;">
          <.icon name="hero-exclamation-circle" class="w-4 h-4 flex-none" />
          {@error}
        </div>
      <% end %>

      <%!-- Form --%>
      <form phx-submit="sign_in" class="space-y-4">

        <TextField.text_field
          name="email"
          value=""
          label="Email"
          placeholder="seu@email.com"
          color="natural"
          type="email"
          autocomplete="email"
        >
          <:start_section>
            <.icon name="hero-envelope" class="size-4 text-slate-400" />
          </:start_section>
        </TextField.text_field>

        <TextField.text_field
          name="password"
          value=""
          label="Senha"
          placeholder="••••••••"
          color="natural"
          type="password"
          autocomplete="current-password"
        >
          <:start_section>
            <.icon name="hero-lock-closed" class="size-4 text-slate-400" />
          </:start_section>
        </TextField.text_field>

        <div class="pt-2">
          <MishkaButton.button
            type="submit"
            color="primary"
            full_width
            size="large"
            class={if @loading, do: "opacity-70 cursor-not-allowed", else: ""}
          >
            <%= if @loading do %>
              <span class="flex items-center justify-center gap-2">
                <.icon name="hero-arrow-path" class="w-4 h-4 animate-spin" />
                Entrando...
              </span>
            <% else %>
              Entrar
            <% end %>
          </MishkaButton.button>
        </div>

      </form>

      <%!-- Register link --%>
      <p class="text-center text-sm" style="color:#475569;">
        Não tem uma conta?{" "}
        <a href="/register" style="color:#22d3ee;" class="hover:underline">Criar conta</a>
      </p>

    </div>
  </div>

</div>
