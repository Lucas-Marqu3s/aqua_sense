<Layouts.app
  flash={@flash}
  current_user={@current_user}
  nav={@nav}
  active={@active_tab}
  device={@device}
  crumb="Reservatório Central · Campus"
  title={@page_title}
>
  <:actions>
    <button type="button" class="as-btn as-btn-ghost">
      <.icon name="hero-calendar" class="size-3.5" /> Hoje
    </button>
    <button type="button" class="as-btn as-btn-ghost">
      <.icon name="hero-arrow-down-tray" class="size-3.5" /> Exportar
    </button>
    <span class="as-chip as-chip-tone as-tone-ok h-8 px-3">
      <span class="size-1.5 rounded-full bg-ok-mark"></span> Ao vivo
    </span>
  </:actions>

  <%!-- ══ VISÃO GERAL ══ --%>
  <div :if={@active_tab == "overview"} class="flex flex-col gap-4">
    <.status_banner tone={@banner.tone} title={@banner.title} meta="leitura 14:30 · há 42 s">
      <:detail>{@banner.detail}</:detail>
      <:actions>
        <button
          type="button"
          class="as-btn as-btn-ghost bg-surface"
          phx-click="set_nav"
          phx-value-tab="alerts"
        >
          Ver alertas
        </button>
      </:actions>
    </.status_banner>

    <div class="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-4">
      <.metric_card
        :for={param <- @parameters}
        id={param.dom_id}
        series={param.series}
        label={param.label}
        value={param.formatted}
        unit={param.unit}
        icon={param.icon}
        delta={param.delta}
        delta_dir={param.delta_dir}
        tone={param.tone}
        tone_label={param.tone_label}
        chart={param.spark}
        limit={param.limit}
        limit_label={param.limit_label}
        fill_pct={param.fill_pct}
        limit_pct={param.limit_pct}
      />
    </div>

    <div class="grid grid-cols-1 gap-4 xl:grid-cols-3">
      <section class="as-card flex flex-col gap-4 p-5">
        <div>
          <h2 class="text-[14.5px] font-semibold">Coluna de medição</h2>
          <p class="mt-0.5 text-xs text-ink-3">Capacidade nominal 20.000 L</p>
        </div>
        <.tank id="tanque" level={@level} min_level={20.0} capacity={20_000} />
        <dl class="flex flex-col">
          <div
            :for={
              stat <- [
                %{label: "Autonomia estimada", value: "47 h", note: "no consumo médio"},
                %{label: "Última recarga", value: "há 5 h 30", note: "+27,5 pp em 3 h"},
                %{label: "Consumo hoje", value: "3.240 L", note: "−8% vs. ontem"}
              ]
            }
            class="flex items-baseline gap-2.5 border-t border-hairline py-2.5"
          >
            <dt class="grow text-[12.5px] text-ink-2">{stat.label}</dt>
            <dd class="text-right">
              <span class="as-num block text-[13.5px] font-semibold text-ink">{stat.value}</span>
              <span class="block text-[11px] text-ink-3">{stat.note}</span>
            </dd>
          </div>
        </dl>
      </section>

      <section class="as-s-level as-card flex flex-col gap-3.5 p-5 xl:col-span-2">
        <div class="flex flex-wrap items-start gap-3">
          <div>
            <h2 class="text-[14.5px] font-semibold">Nível do reservatório</h2>
            <p class="mt-0.5 text-xs text-ink-3">
              Porcentagem da capacidade · 48 leituras nas últimas 24 h
            </p>
          </div>
        </div>

        <.line_chart
          id="grafico-nivel"
          chart={@level_chart}
          width={790}
          height={286}
          unit="%"
          ticks={@level_ticks}
          x_labels={@x_labels}
          limit={20.0}
          limit_label="MÍNIMO OPERACIONAL 20%"
          limit_side={:below}
          annotation={%{index: 24, text: "recarga do poço"}}
          label="Nível do reservatório nas últimas 24 horas, entre 59,6% e 87,1% da capacidade, com recarga às 9 h."
        />

        <div class="flex flex-wrap items-center gap-5 border-t border-hairline pt-3">
          <div :for={
            stat <- [
              %{label: "Mínimo 24 h", value: "59,6 %"},
              %{label: "Máximo 24 h", value: "87,1 %"},
              %{label: "Média", value: "74,4 %"}
            ]
          }>
            <p class="text-[11px] text-ink-3">{stat.label}</p>
            <p class="as-num mt-0.5 text-sm font-semibold text-ink">{stat.value}</p>
          </div>
        </div>
      </section>
    </div>

    <div class="grid grid-cols-1 gap-4 xl:grid-cols-2">
      <section class="as-card flex flex-col p-5">
        <div class="flex items-center gap-2.5 pb-1.5">
          <h2 class="text-[14.5px] font-semibold">Alertas recentes</h2>
          <button
            type="button"
            class="ml-auto text-[12.5px] font-medium text-level hover:underline"
            phx-click="set_nav"
            phx-value-tab="alerts"
          >
            Ver todos
          </button>
        </div>
        <.alert_item
          :for={alert <- Enum.take(@alerts, 3)}
          tone={alert.tone}
          title={alert.title}
          badge={alert.badge}
          meta={alert.meta}
          class="border-t border-hairline py-3"
        >
          <:detail>{alert.detail}</:detail>
        </.alert_item>
      </section>

      <section class="as-card flex flex-col p-5">
        <div class="flex items-center gap-2.5 pb-1.5">
          <h2 class="text-[14.5px] font-semibold">Demais parâmetros · 24 h</h2>
          <span class="ml-auto text-[11px] text-ink-3">— — limite legal</span>
        </div>
        <div
          :for={param <- Enum.reject(@parameters, &(&1.key == :level))}
          class={["border-t border-hairline py-3", series_class(param.series)]}
        >
          <div class="mb-1 flex items-baseline gap-2">
            <h3 class="text-[12.5px] font-semibold text-ink">{param.label}</h3>
            <span class="as-num ml-auto text-[13px] font-semibold text-ink">
              {param.formatted}
            </span>
            <span class="text-[11px] text-ink-3">{param.unit}</span>
          </div>
          <.line_chart
            id={"mini-#{param.key}"}
            chart={param.small}
            width={320}
            height={116}
            unit={param.unit}
            ticks={param.small_ticks}
            decimals={param.decimals}
            x_labels={[
              %{index: 0, text: "00h", anchor: "start"},
              %{index: 24, text: "12h", anchor: "middle"},
              %{index: 47, text: "agora", anchor: "end"}
            ]}
            limit={param.limit}
            label={"#{param.label} nas últimas 24 horas, agora em #{param.formatted} #{param.unit}."}
          />
        </div>
      </section>
    </div>
  </div>

  <%!-- ══ HISTÓRICO ══ --%>
  <div :if={@active_tab == "history"} class="flex flex-col gap-4">
    <div class="as-seg w-fit" role="group" aria-label="Parâmetro em destaque">
      <button
        :for={param <- @parameters}
        type="button"
        aria-pressed={to_string(@chart_tab == Atom.to_string(param.key))}
        phx-click="set_chart_tab"
        phx-value-tab={param.key}
      >
        {param.label}
      </button>
    </div>

    <section class={["as-card flex flex-col gap-3.5 p-5", series_class(@history.series)]}>
      <div class="flex flex-wrap items-start gap-3">
        <div>
          <h2 class="text-[15px] font-semibold">{@history.label}</h2>
          <p class="mt-0.5 text-xs text-ink-3">
            {@history.unit} · {@history.limit_label} (Portaria GM/MS nº 888/2021) · 48 leituras
          </p>
        </div>
        <div class="ml-auto flex flex-wrap items-center gap-4">
          <span class="flex items-center gap-2 text-xs text-ink-2">
            <span class="h-0.5 w-3.5 rounded-sm bg-[var(--as-series)]"></span> leitura
          </span>
          <span class="flex items-center gap-2 text-xs text-ink-2">
            <span class="w-3.5 border-t-2 border-dashed border-crit-mark"></span> limite legal
          </span>
        </div>
      </div>

      <.line_chart
        id="grafico-historico"
        chart={@history_chart}
        width={1104}
        height={340}
        unit={@history.unit}
        ticks={@history_ticks}
        decimals={@history.decimals}
        x_labels={@x_labels}
        limit={@history.limit}
        limit_label="ACIMA DO LIMITE LEGAL"
        marker_label={@history.formatted}
        fill={@history.key == :level}
        label={"#{@history.label} nas últimas 24 horas, agora em #{@history.formatted} #{@history.unit}."}
      />
    </section>

    <section class="as-card p-5">
      <h2 class="text-[14.5px] font-semibold">Todos os parâmetros · mesma janela de 24 h</h2>
      <p class="mt-0.5 mb-3.5 text-xs text-ink-3">
        Cada parâmetro na sua própria escala e unidade. A linha do tempo é compartilhada, então
        quedas e picos simultâneos ficam alinhados na vertical.
      </p>
      <div class="grid grid-cols-1 gap-x-6 gap-y-4 md:grid-cols-2">
        <div :for={param <- @parameters} class={series_class(param.series)}>
          <div class="mb-1.5 flex items-baseline gap-2">
            <span class="size-2.5 shrink-0 rounded-sm bg-[var(--as-series)]"></span>
            <h3 class="text-[13px] font-semibold text-ink">{param.label}</h3>
            <span class="as-num ml-auto text-[13px] font-semibold text-ink">
              {param.formatted}
            </span>
            <span class="text-[11px] text-ink-3">{param.unit}</span>
          </div>
          <.line_chart
            id={"hist-#{param.key}"}
            chart={param.small}
            width={320}
            height={116}
            unit={param.unit}
            ticks={param.small_ticks}
            decimals={param.decimals}
            x_labels={[
              %{index: 0, text: "00h", anchor: "start"},
              %{index: 24, text: "12h", anchor: "middle"},
              %{index: 47, text: "agora", anchor: "end"}
            ]}
            limit={param.limit}
            label={"#{param.label} nas últimas 24 horas, agora em #{param.formatted} #{param.unit}."}
          />
        </div>
      </div>
    </section>
  </div>

  <%!-- ══ ALERTAS ══ --%>
  <section :if={@active_tab == "alerts"} class="as-card p-5">
    <div class="flex items-center gap-2.5 pb-1.5">
      <h2 class="text-[14.5px] font-semibold">Central de alertas</h2>
      <span class="as-chip as-chip-tone as-tone-warn">{@open_alerts} em aberto</span>
      <span class="ml-auto text-xs text-ink-3">{length(@alerts)} eventos nas últimas 24 h</span>
    </div>
    <.alert_item
      :for={alert <- @alerts}
      tone={alert.tone}
      title={alert.title}
      badge={alert.badge}
      meta={alert.meta}
      class="border-t border-hairline py-4"
    >
      <:detail>{alert.detail}</:detail>
      <:actions>
        <button :if={alert.open?} type="button" class="as-btn as-btn-ghost">
          <.icon name="hero-check" class="size-3.5" /> Reconhecer
        </button>
      </:actions>
    </.alert_item>
  </section>

  <%!-- ══ SISTEMA ══ --%>
  <div :if={@active_tab == "settings"} class="grid grid-cols-1 gap-4 xl:grid-cols-2">
    <section class="as-card p-5">
      <h2 class="text-[14.5px] font-semibold">Componentes do sistema</h2>
      <p class="mt-0.5 mb-2 text-xs text-ink-3">
        {Enum.count(@system_status, &(&1.tone == :ok))} de {length(@system_status)} operando normalmente
      </p>
      <div
        :for={service <- @system_status}
        class={["flex items-center gap-3 border-t border-hairline py-3", tone_class(service.tone)]}
      >
        <span class="size-2 shrink-0 rounded-full bg-[var(--as-tone)]"></span>
        <div class="min-w-0 grow">
          <p class="text-[12.5px] font-semibold text-ink">{service.name}</p>
          <p class="as-num mt-0.5 text-[11.5px] text-ink-3">{service.detail}</p>
        </div>
        <.status_chip tone={service.tone} label={service.label} />
      </div>
    </section>

    <section class="as-card p-5">
      <h2 class="text-[14.5px] font-semibold">Limites da Portaria GM/MS nº 888/2021</h2>
      <p class="mt-0.5 mb-2 text-xs text-ink-3">
        Valores de referência para água destinada ao consumo humano.
      </p>
      <div
        :for={row <- @legal_limits}
        class="flex items-center justify-between border-t border-hairline py-3"
      >
        <span class="text-[12.5px] text-ink-2">{row.parameter}</span>
        <span class="as-num text-[12.5px] font-semibold text-ink">{row.limit}</span>
      </div>
    </section>
  </div>

  <%!-- ══ USUÁRIOS ══ --%>
  <div :if={@active_tab == "users"} class="grid grid-cols-1 gap-4 xl:grid-cols-3">
    <section class="as-card p-5">
      <h2 class="text-[14.5px] font-semibold">Novo usuário</h2>
      <p class="mt-0.5 mb-3.5 text-xs text-ink-3">
        Contas criadas aqui já entram liberadas, sem passar pela fila de aprovação.
      </p>

      <p
        :if={@user_form.success}
        class="as-tone-ok mb-3.5 flex items-center gap-2 rounded-lg border border-[var(--as-tone)] bg-[var(--as-tone-tint)] p-3 text-[12.5px] text-[var(--as-tone-text)]"
      >
        <.icon name="hero-check-circle" class="size-4 shrink-0" />{@user_form.success}
      </p>
      <p
        :if={@user_form.error}
        class="as-tone-crit mb-3.5 flex items-center gap-2 rounded-lg border border-[var(--as-tone)] bg-[var(--as-tone-tint)] p-3 text-[12.5px] text-[var(--as-tone-text)]"
      >
        <.icon name="hero-x-circle" class="size-4 shrink-0" />{@user_form.error}
      </p>

      <form id="create-user-form" phx-submit="create_user" class="flex flex-col gap-1">
        <.input
          id="new-user-name"
          name="name"
          value={@user_form.name}
          type="text"
          label="Nome completo"
          placeholder="Maria Oliveira"
          required
        />
        <.input
          id="new-user-email"
          name="email"
          value={@user_form.email}
          type="email"
          label="E-mail"
          placeholder="maria@facens.br"
          required
        />
        <.input
          id="new-user-password"
          name="password"
          value=""
          type="password"
          label="Senha provisória"
          placeholder="mínimo 8 caracteres"
          minlength="8"
          required
        />
        <button id="create-user-submit" type="submit" class="as-btn as-btn-primary mt-2 w-full">
          <.icon name="hero-user-plus" class="size-4" /> Criar usuário
        </button>
      </form>
    </section>

    <section class="as-card p-5 xl:col-span-2">
      <div class="flex flex-wrap items-center gap-2.5 pb-1.5">
        <h2 class="text-[14.5px] font-semibold">Usuários cadastrados</h2>
        <span class="as-chip bg-inset text-ink-2">{length(@users)}</span>
        <span class="ml-auto text-xs text-ink-3">
          {Enum.count(@users, & &1.confirmed_at)} ativos · {Enum.count(
            @users,
            &is_nil(&1.confirmed_at)
          )} aguardando liberação
        </span>
      </div>

      <p :if={@users == []} class="border-t border-hairline py-10 text-center text-sm text-ink-3">
        Nenhum usuário cadastrado ainda.
      </p>

      <div
        :for={user <- @users}
        class="flex items-center gap-3 border-t border-hairline py-3"
        id={"user-#{user.id}"}
      >
        <span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-level-tint text-[12.5px] font-bold text-level">
          {user.name |> String.first() |> String.upcase()}
        </span>
        <div class="min-w-0 grow">
          <p class="truncate text-[13.5px] font-semibold text-ink">{user.name}</p>
          <p class="truncate text-xs text-ink-3">{user.email}</p>
        </div>
        <.status_chip :if={user.confirmed_at} tone={:ok} label="Ativo" />
        <button
          :if={is_nil(user.confirmed_at)}
          type="button"
          class="as-btn as-btn-ghost"
          phx-click="confirm_user"
          phx-value-id={user.id}
        >
          Liberar acesso
        </button>
      </div>
    </section>
  </div>
</Layouts.app>
